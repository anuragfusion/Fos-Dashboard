# Where n8n is running. The Vite dev proxy targets this base URL.
N8N_URL=http://localhost:5678

# Secret for the n8n Header Auth credential. Server-side only — never shipped to the browser.
FOS_KEY=change-me

# Path the browser calls. Default is the proxy path; only change to a full URL if you skip the proxy.
VITE_FOS_API=/fos-api

# true => load src/api/dashboard.sample.json instead of hitting the API.
VITE_USE_MOCK=false
